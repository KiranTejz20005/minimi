# LLM (required): set ONE. Anthropic wins if both are set.
# NVIDIA NIM, free tier: https://build.nvidia.com
NVIDIA_API_KEY=nvapi-REPLACE_ME
LLM_BASE_URL=
MODEL_MAIN=poolside/laguna-xs-2.1
MODEL_FAST=nvidia/nemotron-3.5-bolt-e4b

# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Web search (optional, recommended): https://app.tavily.com
# Blank = keyless fallback search (works, lower quality).
TAVILY_API_KEY=tvly-REPLACE_ME

PORT=3000
