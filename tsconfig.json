{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.ts",
    "scripts/seed.ts",
    "scripts/eval.ts",
    "scripts/eval-fixtures.ts",
    "scripts/build-web-lib.ts",
    "scripts/build-web.ts",
    "test/**/*.ts",
    "scripts/build-vercel.ts",
    "web/api.ts",
    "web/env.d.ts"
  ]
}
