{
  "name": "minimi-websearch-agent",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:prod": "node --import tsx src/server.ts",
    "build": "tsx scripts/build-web.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "seed:fixtures": "tsx scripts/seed.ts --fixtures",
    "eval": "tsx scripts/eval.ts",
    "eval:latency": "tsx scripts/latency.ts",
    "eval:live": "tsx scripts/eval-live.ts",
    "build:web": "tsx scripts/build-web.ts",
    "build:vercel": "tsx scripts/build-vercel.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@hono/node-server": "^1.19.0",
    "@mozilla/readability": "^0.6.0",
    "@types/dompurify": "^3.0.5",
    "chrono-node": "^2.9.0",
    "dompurify": "^3.4.17",
    "dotenv": "^16.4.7",
    "esbuild": "^0.25.0",
    "hono": "^4.10.0",
    "linkedom": "^0.18.15",
    "luxon": "^3.7.0",
    "marked": "^15.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "read-excel-file": "^9.3.20",
    "tsx": "^4.20.0",
    "unpdf": "^2.2.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "description": "Time-aware web search chat agent with verified memory recall",
  "private": true
}
